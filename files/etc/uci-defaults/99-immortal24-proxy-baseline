#!/bin/sh
# Safe baseline: do not modify LAN IP/gateway; disable competing proxy/DNS services.

# IPv4-only baseline for this profile: disable RA/DHCPv6/NDP on LAN.
if uci -q get dhcp.lan >/dev/null 2>&1; then
    uci set dhcp.lan.ra='disabled'
    uci set dhcp.lan.dhcpv6='disabled'
    uci set dhcp.lan.ndp='disabled'
    uci set dhcp.lan.ra_management='disabled'
fi

# Disable flow offloading by default; TUN/transparent proxy setups need netfilter visibility.
if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
    uci set firewall.@defaults[0].flow_offloading='0'
    uci set firewall.@defaults[0].flow_offloading_hw='0'
fi

for svc in openclash passwall passwall2 nikki homeproxy mosdns smartdns openbox open-box; do
    if [ -x "/etc/init.d/$svc" ]; then
        "/etc/init.d/$svc" stop >/dev/null 2>&1 || true
        "/etc/init.d/$svc" disable >/dev/null 2>&1 || true
    fi
done

# Store custom OpenClash rule switch; do not enable OpenClash until a valid YAML is installed.
if uci -q get openclash.config >/dev/null 2>&1; then
    uci set openclash.config.enable_custom_clash_rules='1'
    uci set openclash.config.dns_port='1053'
    uci set openclash.config.enable_redirect_dns='1'
    uci set openclash.config.redirect_dns='1'
    uci set openclash.config.enable_respect_rules='1'
    uci set openclash.config.enable_custom_dns='0'
    uci set openclash.config.append_default_dns='0'
    uci set openclash.config.append_wan_dns='0'
    uci set openclash.config.en_mode='fake-ip-tun'
    uci set openclash.config.operation_mode='fake-ip'
    uci set openclash.config.proxy_mode='rule'
    uci set openclash.config.store_fakeip='1'
    uci set openclash.config.ipv6_enable='0'
    uci set openclash.config.ipv6_dns='0'
    uci set openclash.config.smart_enable='0'
    uci set openclash.config.enable_udp_proxy='1'
    uci set openclash.config.disable_udp_quic='0'
    uci set openclash.config.core_type='Meta'
    uci set openclash.config.stack_type='mixed'
    uci set openclash.config.disable_masq_cache='1'
    uci set openclash.config.skip_proxy_address='1'
    uci commit openclash
fi

uci commit dhcp
uci commit firewall
/etc/init.d/firewall reload >/dev/null 2>&1 || true

exit 0
