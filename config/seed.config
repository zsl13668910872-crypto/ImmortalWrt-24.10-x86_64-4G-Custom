# ImmortalWrt 24.10 x86_64 generic EFI / 4GB rootfs
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_TARGET_IMAGES_GZIP=y
# EFI image only; keep ISO disabled for this PVE profile
# CONFIG_ISO_IMAGES is not set
# Diagnostics / observability
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_conntrack-tools=y
# BBR kernel module when available
CONFIG_PACKAGE_kmod-tcp-bbr=y
